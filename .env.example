# Canonical public origin. No path, query string, credentials, or fragment.
NEXT_PUBLIC_SITE_URL=https://uestc.de5.net

# Optional ownership verification: paste only the meta tag's content value.
# DNS verification can be used instead; never put account passwords or API keys here.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Optional GA4 web stream Measurement ID. Leave blank to emit no Google script.
# Configure manual pageviews as described in docs/search-and-analytics.md.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
